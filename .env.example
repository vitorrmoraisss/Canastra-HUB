# ── Django ───────────────────────────────────────────────────────────────────
# Chave secreta: obrigatória fora do desenvolvimento e igual em web e scheduler.
# Gere com: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=<type_your_secret_key_here>
DEBUG=True
# Hosts aceitos, separados por vírgula (ex.: canastrahub.com.br,www.canastrahub.com.br)
ALLOWED_HOSTS=*
# URL pública do sistema, usada nos links dos e-mails (sem barra no final)
SITE_URL=http://localhost:8000

# ── Banco de dados ───────────────────────────────────────────────────────────
DB_NAME=db_canastra
DB_USER=postgres
DB_PASSWORD=<type_your_password_here>
DB_HOST=localhost
DB_PORT=5432

# ── E-mail (web app do Google Apps Script) ───────────────────────────────────
GAS_EMAIL_URL=https://script.google.com/macros/s/SUA_URL_DO_APPS_SCRIPT/exec
# Deve ser igual ao segredo configurado nas propriedades do Apps Script de e-mail
GAS_API_SECRET=<type_your_secret_here>
# E-mail que recebe os pedidos de aprovação de reservas do hub
EMAIL_HUB_APROVACAO=hub.confirmacoes@exemplo.com

# ── Agenda das salas (Apps Script da agenda/planilha) ────────────────────────
APPS_SCRIPT_URL=https://script.google.com/macros/s/SUA_URL_DO_APPS_SCRIPT_DA_AGENDA/exec
# Deve ser igual ao token configurado no Apps Script da agenda
APPS_SCRIPT_TOKEN=<type_your_token_here>

# ── Recuperação de senha ─────────────────────────────────────────────────────
RECUPERACAO_URL=https://script.google.com/macros/library/d/1leotsnUiRPeMtLQ4_1eM_tWtrRd_VVZyx8upklbBUJHuW3K0iBO7lcEZ/2
RECUPERACAO_API_KEY=<type_your_api_key_here>

# ── Limites do currículo (instâncias por tipo) ───────────────────────────────
DEFAULT_INSTANCES=3
EXPERIENCIA_PROFISSIONAL_INSTANCES=3
CURSO_EXTRA_CURRICULAR_INSTANCES=3
IDIOMA_INSTANCES=3

# ── Matching ─────────────────────────────────────────────────────────────────
# Compatibilidade mínima (0 a 100) para gerar match interesse de compra × produto
PRODUCT_MATCH_THRESHOLD=55

# ── E-mail semanal de vagas compatíveis ──────────────────────────────────────
# Dia do disparo: 0=segunda 1=terça 2=quarta 3=quinta 4=sexta 5=sábado 6=domingo
VAGAS_EMAIL_DIA_SEMANA=0
# Horário do disparo (HH:MM, horário de Brasília)
VAGAS_EMAIL_HORARIO=09:00
# Compatibilidade mínima da vaga (0 a 1; 0.5 = 50%)
VAGAS_EMAIL_SCORE_MINIMO=0.5
# Máximo de vagas por e-mail
VAGAS_EMAIL_LIMITE=5
# Tentativas de envio por destinatário em cada disparo
VAGAS_EMAIL_TENTATIVAS=3
